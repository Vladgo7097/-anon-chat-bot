# nginx site for the website (web/ FastAPI service, container port 8080).
#
# Install once the real domain is pointed at this server:
#   sed 's/{{DOMAIN}}/your.domain/g' deploy/nginx-web.conf.example > /etc/nginx/sites-available/anon-chat-web
#   ln -s /etc/nginx/sites-available/anon-chat-web /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d {{DOMAIN}}          # issues the cert and rewrites this file for HTTPS
#
# After that, also set the domain with @BotFather (/setdomain) for the Login
# Widget, and register the Mini App URL (https://{{DOMAIN}}/) if using one --
# both are required before Telegram will accept auth from this site at all.

server {
    listen 80;
    server_name {{DOMAIN}};

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
